# Public (browser-safe) Supabase values only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional site URL used by auth redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Server-only email.
# Preferred for this fellowship: Gmail with an App Password.
# 1. Use a Google account with 2-Step Verification on
# 2. Google Account → Security → App passwords → create one for "Mail"
# 3. Fill GMAIL_USER and GMAIL_APP_PASSWORD below, then restart the app
EMAIL_MODE=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. Defaults to GMAIL_USER when empty.
FELLOWSHIP_EMAIL_FROM=

# Optional alternative provider (leave empty when using Gmail).
RESEND_API_KEY=

# Local-only fallback (prints emails in the Next.js terminal): EMAIL_MODE=console

# Server-only. Required for /api/jobs/notifications (Bearer token).
# Generate a strong value for production, e.g. openssl rand -hex 32
# Also set this in Vercel → Environment Variables for Production.
CRON_SECRET=
